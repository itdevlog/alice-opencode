# Ключ OpenCode Go (opencode.ai/auth -> API key). НЕ коммитить.
OPENCODE_API_KEY=sk-opencode-your-key-here

# OpenAI-совместимый эндпоинт OpenCode Go
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Модель по умолчанию (deepseek-v4.1-flash — самая быстрая)
MODEL=deepseek-v4.1-flash

# Путь к файлу SQLite
DB_PATH=data/alice.db

# Адрес и порт веб-сервера. 127.0.0.1 безопаснее: порт не торчит в интернет,
# наружу его отдаёт Caddy (HTTPS).
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8000

# Публичный HTTPS-URL навыка (для команды `./manage.sh caddy`).
WEBAPP_URL=https://alice.example.com

# ID навыка из консоли Яндекс.Диалогов (для проверки входящих запросов). Можно оставить пустым.
SKILL_ID=

# Внутренний дедлайн ответа в секундах (у Алисы общий лимит 4.5с)
REQUEST_DEADLINE_SECONDS=3.5

# Максимум токенов в ответе (короче = быстрее)
MAX_TOKENS=600

# Сколько последних реплик подавать в контекст
HISTORY_LIMIT=10

# Звук/музыка ожидания (ID ресурса из консоли Диалогов), необязательно.
# Пусто = только короткая пауза. Пример: dialogs-upload/relax-railways.opus
WAIT_SOUND=
